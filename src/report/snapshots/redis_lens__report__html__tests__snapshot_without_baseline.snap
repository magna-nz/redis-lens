</table>
<script>document.querySelectorAll('table.sortable th').forEach(function(th,i){th.addEventListener('click',function(){var b=th.closest('table').tBodies[0],rs=Array.prototype.slice.call(b.rows),d=th.dataset.dir=th.dataset.dir==='asc'?'desc':'asc';rs.sort(function(x,y){var a=x.cells[i].dataset.v||x.cells[i].textContent,c=y.cells[i].dataset.v||y.cells[i].textContent,na=parseFloat(a),nc=parseFloat(c),r=(isNaN(na)||isNaN(nc))?a.localeCompare(c):na-nc;return d==='asc'?r:-r;});rs.forEach(function(r){b.appendChild(r);});});});</script>
