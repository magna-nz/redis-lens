source: src/report/html.rs
expression: "render(&after, None, false)"
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'">
<title>redis-lens report: staging</title>
<style>body{font:14px/1.45 system-ui,sans-serif;margin:2rem auto;max-width:64rem;padding:0 1rem;color:#1b1f23}h1{font-size:1.4rem}h2{font-size:1.1rem;margin-top:2rem}table{border-collapse:collapse;width:100%}th,td{padding:.3rem .6rem;border-bottom:1px solid #e1e4e8;text-align:left}th{cursor:pointer;background:#f6f8fa;white-space:nowrap}td.n,th.n{text-align:right}.bar{background:#e1e4e8;width:8rem;height:.7rem;border-radius:2px}.bar span{display:block;height:100%;background:#0366d6;border-radius:2px}dl{display:grid;grid-template-columns:max-content 1fr;gap:.2rem 1rem}dt{font-weight:600}dd{margin:0}.warn{color:#b31d28;font-weight:600}.muted{color:#586069}code{font-family:ui-monospace,monospace}</style>
</head>
<body>
<h1>redis-lens report: staging</h1>
